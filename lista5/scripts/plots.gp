set terminal pngcairo size 1100,750 enhanced font 'Arial,11'
set grid; set key outside; set datafile separator whitespace
set xlabel 't'; set ylabel 'v'; set output 'fhn_v_time.png'
plot 'data/fhn_v_m080.dat' u 1:2 w l t 'v(0)=-0.8', 'data/fhn_v_m065.dat' u 1:2 w l t 'v(0)=-0.65', 'data/fhn_v_m064.dat' u 1:2 w l t 'v(0)=-0.64', 'data/fhn_v_0.dat' u 1:2 w l t 'v(0)=0'
set ylabel 'w'; set output 'fhn_w_time.png'
plot 'data/fhn_v_m080.dat' u 1:3 w l t '-0.8', 'data/fhn_v_m065.dat' u 1:3 w l t '-0.65', 'data/fhn_v_m064.dat' u 1:3 w l t '-0.64', 'data/fhn_v_0.dat' u 1:3 w l t '0'
set xlabel 'v'; set ylabel 'w'; set output 'fhn_phase_I0.png'
plot 'data/fhn_null_0.dat' u 1:2 w l lw 2 t 'v nullcline', '' u 1:3 w l lw 2 t 'w nullcline', 'data/fhn_v_m080.dat' u 2:3 w l t 'v0=-0.8', 'data/fhn_v_m065.dat' u 2:3 w l t 'v0=-0.65', 'data/fhn_v_m064.dat' u 2:3 w l t 'v0=-0.64', 'data/fhn_v_0.dat' u 2:3 w l t 'v0=0'
set xlabel 't'; set ylabel 'v'; set output 'fhn_I1_I15_time.png'
plot 'data/fhn_I1.dat' u 1:2 w l t 'I=1', 'data/fhn_I15.dat' u 1:2 w l t 'I=1.5'
set xlabel 'v'; set ylabel 'w'; set output 'fhn_phase_I1.png'
plot 'data/fhn_null_1.dat' u 1:2 w l t 'v nullcline', '' u 1:3 w l t 'w nullcline', 'data/fhn_I1.dat' u 2:3 w l t 'trajectory I=1'
set output 'fhn_phase_I15.png'
plot 'data/fhn_null_2.dat' u 1:2 w l t 'v nullcline', '' u 1:3 w l t 'w nullcline', 'data/fhn_I15.dat' u 2:3 w l t 'trajectory I=1.5'
# Morris-Lecar base pulse responses
set xlabel 't (ms)'; set ylabel 'V (mV)'; set output 'ml_base_V_time.png'
plot 'data/ml_b_m18.dat' u 1:2 w l t 'V0=-18', 'data/ml_b_m148.dat' u 1:2 w l t 'V0=-14.8', 'data/ml_b_m147.dat' u 1:2 w l t 'V0=-14.7', 'data/ml_b_m12.dat' u 1:2 w l t 'V0=-12'
set ylabel 'n'; set output 'ml_base_n_time.png'
plot 'data/ml_b_m18.dat' u 1:3 w l t '-18', 'data/ml_b_m148.dat' u 1:3 w l t '-14.8', 'data/ml_b_m147.dat' u 1:3 w l t '-14.7', 'data/ml_b_m12.dat' u 1:3 w l t '-12'
set xlabel 'V (mV)'; set ylabel 'n'; set output 'ml_base_phase_pulses.png'
plot 'data/ml_b_null15.dat' u 1:2 w l lw 2 t 'V nullcline J=15', '' u 1:3 w l lw 2 t 'n nullcline', 'data/ml_b_m18.dat' u 2:3 w l t '-18', 'data/ml_b_m148.dat' u 2:3 w l t '-14.8', 'data/ml_b_m147.dat' u 2:3 w l t '-14.7', 'data/ml_b_m12.dat' u 2:3 w l t '-12'
set xlabel 'J (uA/cm^2)'; set ylabel 'frequency (Hz)'; set output 'ml_base_fI.png'
plot 'data/ml_b_fi.dat' u 1:2 w lp t 'Morris-Lecar base'
set xlabel 'V (mV)'; set ylabel 'n'; set output 'ml_base_phase_J24p8.png'
plot 'data/ml_b_null24p8.dat' u 1:2 w l t 'V nullcline J=24.8', '' u 1:3 w l t 'n nullcline'
set output 'ml_base_phase_J25.png'
plot 'data/ml_b_null25.dat' u 1:2 w l t 'V nullcline J=25', '' u 1:3 w l t 'n nullcline', 'data/ml_b_trace25.dat' u 2:3 w l t 'trajectory'
set xlabel 't (ms)'; set ylabel 'V (mV)'; set output 'ml_base_trace_J25.png'
plot 'data/ml_b_trace25.dat' u 1:2 w l t 'J=25'
# Modified ML
set output 'ml_mod_V_time.png'
plot 'data/ml_m_m40.dat' u 1:2 w l t 'V0=-40', 'data/ml_m_m15.dat' u 1:2 w l t 'V0=-15', 'data/ml_m_m12.dat' u 1:2 w l t 'V0=-12', 'data/ml_m_m2.dat' u 1:2 w l t 'V0=-2'
set ylabel 'n'; set output 'ml_mod_n_time.png'
plot 'data/ml_m_m40.dat' u 1:3 w l t '-40', 'data/ml_m_m15.dat' u 1:3 w l t '-15', 'data/ml_m_m12.dat' u 1:3 w l t '-12', 'data/ml_m_m2.dat' u 1:3 w l t '-2'
set xlabel 'V (mV)'; set ylabel 'n'; set output 'ml_mod_phase_pulses.png'
plot 'data/ml_m_null0.dat' u 1:2 w l lw 2 t 'V nullcline', '' u 1:3 w l lw 2 t 'n nullcline', 'data/ml_m_m40.dat' u 2:3 w l t '-40', 'data/ml_m_m15.dat' u 2:3 w l t '-15', 'data/ml_m_m12.dat' u 2:3 w l t '-12', 'data/ml_m_m2.dat' u 2:3 w l t '-2'
set xlabel 'J (uA/cm^2)'; set ylabel 'frequency (Hz)'; set output 'ml_mod_fI.png'
plot 'data/ml_m_fi.dat' u 1:2 w lp t 'Morris-Lecar modified'
set xlabel 't (ms)'; set ylabel 'V (mV)'; set output 'ml_mod_threshold_traces.png'
plot 'data/ml_m_trace7p9.dat' u 1:2 w l t 'J=7.9', 'data/ml_m_trace8p33.dat' u 1:2 w l t 'J=8.33', 'data/ml_m_trace8p35.dat' u 1:2 w l t 'J=8.35'
set xlabel 'V (mV)'; set ylabel 'n'; set output 'ml_mod_phase_thresholds.png'
plot 'data/ml_m_null7p9.dat' u 1:2 w l t 'V nullcline J=7.9', 'data/ml_m_null7p9.dat' u 1:3 w l t 'n nullcline J=7.9', 'data/ml_m_trace7p9.dat' u 2:3 w l t 'trajectory 7.9'
set output 'ml_mod_phase_J8p33.png'
plot 'data/ml_m_null8p33.dat' u 1:2 w l t 'V nullcline J=8.33', 'data/ml_m_null8p33.dat' u 1:3 w l t 'n nullcline', 'data/ml_m_trace8p33.dat' u 2:3 w l t 'trajectory'
set output 'ml_mod_phase_J8p35.png'
plot 'data/ml_m_null8p35.dat' u 1:2 w l t 'V nullcline J=8.35', 'data/ml_m_null8p35.dat' u 1:3 w l t 'n nullcline', 'data/ml_m_trace8p35.dat' u 2:3 w l t 'trajectory'
